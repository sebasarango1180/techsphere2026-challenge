# Copy to .env and fill in. scripts/setup.sh reads this file.
# See specs/implementation-plan.md for what each service does with these.

# ---- Postgres (control plane: documents, calls, turns, escalations, summaries) ----
POSTGRES_USER=techsphere
POSTGRES_PASSWORD=changeme
POSTGRES_DB=techsphere
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://techsphere:changeme@postgres:5432/techsphere?sslmode=disable
# api-gateway runs infra/postgres/migrations/*.sql at startup via golang-migrate (not
# Postgres's initdb hook). /app/migrations is where the Dockerfile bakes them in; running
# api-gateway outside Docker needs this pointed at the real path instead, e.g.
# MIGRATIONS_PATH=../../infra/postgres/migrations
MIGRATIONS_PATH=/app/migrations
# Same story for the OpenAPI spec api-gateway serves at /docs -- /app/openapi/api-gateway.yaml
# is where the Dockerfile bakes docs/openapi/api-gateway.yaml in; running api-gateway outside
# Docker needs this pointed at the real path instead, e.g.
# OPENAPI_PATH=../../docs/openapi/api-gateway.yaml
OPENAPI_PATH=/app/openapi/api-gateway.yaml

# ---- LiveKit (WebRTC SFU) ----
# Generate with: docker run --rm livekit/livekit-server generate-keys
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=changeme_min_32_chars_______________
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_HOST_URL=http://livekit:7880

# ---- Model serving ----
# Family must stay one of: Google Gemini Flash / Meta Llama via Groq / Meta Llama 3.x 1B-3B
# local / Microsoft Phi Mini 3.5+ local. See stack-tecnico.md#1. Default here: Phi Mini 3.5+ local via Ollama.
LLM_PROVIDER=ollama
OLLAMA_MODEL=phi3.5:3.8b
# On macOS, ollama runs natively (Metal) -- see scripts/setup.sh --native-agent. Point this at
# host.docker.internal instead of the `ollama` service name in that mode.
OLLAMA_HOST=http://ollama:11434

# ---- Speech-to-text (dual mode, see specs/implementation-plan.md §2.2) ----
# STT_MODE=groq | local -- local (faster-whisper) is the default: no external API key
# required, keeps the stack fully self-contained. Set to groq (and fill GROQ_API_KEY)
# to trade that off for Whisper Large V3's accuracy/latency over the network instead.
STT_MODE=local
GROQ_API_KEY=

# ---- Text-to-speech ----
TTS_MODEL=hexgrad/Kokoro-82M
# Must be a real voice file ID from hexgrad/Kokoro-82M's voices/ directory, NOT a bare
# language code -- "es" (a plausible-looking but wrong guess) 404s on
# huggingface.co/hexgrad/Kokoro-82M/resolve/main/voices/es.pt and silently kills every
# TTS call, found live (total call silence, no greeting, no replies). Verified real
# Spanish ("e" lang code) voices via the repo's actual file listing: ef_dora (female),
# em_alex / em_santa (male).
TTS_VOICE=ef_dora

# ---- Embeddings / vector store ----
EMBEDDING_MODEL=BAAI/bge-m3
# Chroma runs as its own server (chromadb/chroma image, always in Docker -- it does no
# GPU/Metal work, so it doesn't follow vector-store natively). These are vector-store's
# defaults for native mode (Docker Desktop publishes the container's port to localhost);
# docker-compose.yml overrides both to the compose-internal hostname for Docker mode.
CHROMA_HOST=localhost
CHROMA_PORT=8000
VECTOR_STORE_URL=http://vector-store:8001

# ---- Dataset (PDFs live in the separate ParticipantArtifacts repo, not vendored here) ----
# If unset, scripts/setup.sh shallow-clones it next to this repo.
DATASET_PATH=../ParticipantArtifacts/dataset

# ---- Internal service URLs (container network defaults; override for native/hybrid runs) ----
API_GATEWAY_URL=http://api-gateway:8080
VOICE_AGENT_METRICS_PORT=9090

# ---- Frontend (two separate apps -- see specs/implementation-plan.md §1) ----
# call-interface: http://localhost:5173 -- admin-console: http://localhost:5174
# NOTE: Vite bakes these in at image build time, not container start -- changing this
# file alone won't affect an already-built image (see either app's Dockerfile comment).
VITE_API_GATEWAY_URL=http://localhost:8080
VITE_LIVEKIT_URL=ws://localhost:7880

# api-gateway's CORS allowlist -- must match wherever the two frontend apps above are
# actually served from, comma-separated. Uncommented deliberately (not left as a
# code-only default): if the frontend ports above ever change and this line doesn't
# change with them, CORS breaks silently again -- exactly the bug this was added to
# fix, so keep this in sync with call-interface/admin-console's actual ports by hand.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
